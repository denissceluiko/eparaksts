{
    "name": "dencel/eparaksts",
    "description": "PHP client library for the eParaksts e-signature and identity platform",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Deniss Celuiko",
            "email": "deniss@celuiko.com",
            "homepage": "https://celuiko.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Dencel\\Eparaksts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dencel\\Eparaksts\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.10",
        "guzzlehttp/psr7": "^2.0",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit",
        "fix": "php-cs-fixer fix",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse"
    }
}
